{
  "name": "grantonce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 43127 --hostname localhost",
    "build": "next build",
    "start": "next start --port 43127 --hostname localhost",
    "lint": "eslint",
    "mcp": "tsx mcp/server.ts",
    "mcp:http": "tsx mcp/server.ts --http",
    "test:mcp": "GRANTONCE_STORE=/tmp/grantonce-mcp-test.json tsx mcp/test.ts",
    "test:flow": "GRANTONCE_STORE=/tmp/grantonce-test.json tsx test/flow.ts",
    "test:rehearsal": "tsx test/rehearsal.ts",
    "test:all": "npm run test:flow && npm run test:mcp && npm run test:race",
    "test:race": "tsx test/race.ts",
    "test:mutate": "tsx test/mutate.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
